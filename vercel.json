{
  "buildCommand": "cd unfazed-frontend && npm install && npm run build",
  "outputDirectory": "unfazed-frontend/dist",
  "installCommand": "cd unfazed-frontend && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://unfazed-3t20.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}